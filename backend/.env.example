# ── AI Provider ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Email (Gmail OAuth — set up via scripts/auth_gmail.py) ───
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password       # Only used for SMTP fallback
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
